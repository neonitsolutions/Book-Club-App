# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3001
# directConnection=true: talk to the single-node replica set from docker-compose
# directly. Production uses the Atlas mongodb+srv:// URI instead.
MONGODB_URI=mongodb://localhost:27017/readers-bookclub?directConnection=true
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Signs login tokens; at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-dev-secret-at-least-32-chars
# Optional: `npm run db:seed` creates this admin account (password 12+ chars)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
