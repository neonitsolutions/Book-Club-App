# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/readers-bookclub
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Signs login tokens; at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-dev-secret-at-least-32-chars
